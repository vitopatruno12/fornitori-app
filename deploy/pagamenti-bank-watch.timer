[Unit]
Description=ATLAS agente Pagamenti + banca (mar, mer, ven alle 9:30 e alle 18:30)
Requires=pagamenti-bank-watch.service

[Timer]
OnCalendar=Tue,Wed,Fri *-*-* 09:30:00
OnCalendar=Tue,Wed,Fri *-*-* 18:30:00
Persistent=true
RandomizedDelaySec=120
Unit=pagamenti-bank-watch.service

[Install]
WantedBy=timers.target
