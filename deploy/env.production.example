; Template per /opt/fornitori-app/backend/.env in produzione.
; Copialo (rinomina in .env) e EDITA i valori reali.
;
; IMPORTANTE: NON committare mai il file .env reale nel repo.
; Permessi: chmod 600 /opt/fornitori-app/backend/.env (solo proprietario lo legge).

# --- Database ---
# Prendi questo valore da /root/fornitori_db_credentials.txt (creato da install-server.sh)
# Esempio (sostituisci PASSWORD generato):
DATABASE_URL=postgresql://fornitori_user:PASSWORD_AUTOGENERATED_HERE@localhost:5432/fornitori_db

# --- CORS ---
# In produzione vuoi limitare gli origin che possono chiamare l'API.
# Frontend pubblico ATLAS (www + apex):
CORS_ORIGINS=https://www.atlass.it,https://atlass.it
CORS_ORIGIN_REGEX=https://(www\.)?atlass\.it

# --- Comportamento app ---
LOG_LEVEL=INFO
DEBUG_ERRORS=false
ALLOW_STARTUP_DB_FAILURE=true

# --- Integrazioni opzionali (lascia vuote se non usate) ---

# SDI / Agenzia Entrate (ricezione XML fatture, senza intermediario Aruba):
#SDI_RECEIVE_TOKEN=
#SDI_DEST_ABBA_KEYWORDS=abba,via abba
#SDI_DEST_ZANARDELLI_KEYWORDS=zanardelli,via zanardelli

# VNE (area cassa):
#VNE_USERNAME=
#VNE_PASSWORD=

# EasyRetail GDB sync (agent PC cassa → /api/pos-receipts/ingest):
# Stesso valore in C:\AtlasSync\.env sul PC cassa
#EASYRETAIL_SYNC_TOKEN=genera-un-token-lungo-segreto

# --- Link codici: password sblocco (OTP WhatsApp disattivato in UI) ---
ACCESS_CODES_UNLOCK_PASSWORD=Burnet

# --- Link codici OTP su WhatsApp Business (Meta) ---
#ACCESS_CODES_OTP_WEBHOOK_URL=http://127.0.0.1:8791/send
#WHATSAPP_CLOUD_TOKEN=
#WHATSAPP_PHONE_NUMBER_ID=
#WHATSAPP_OTP_TEMPLATE=atlas_otp

# --- Enable Banking (AIS) ---
#ENABLE_BANKING_APP_ID=
#ENABLE_BANKING_KEY_PATH=/opt/fornitori-app/backend/keys/app-id.pem
#ENABLE_BANKING_REDIRECT_URL=https://www.atlass.it/api/banca/callback
#ENABLE_BANKING_ENVIRONMENT=sandbox
#ENABLE_BANKING_ASPSP_NAME=Nordea
#ENABLE_BANKING_ASPSP_COUNTRY=FI
#ENABLE_BANKING_FRONTEND_URL=https://www.atlass.it
#WHATSAPP_OTP_TEMPLATE_LANG=it
#DEBUG_ERRORS=false
#ACCESS_CODES_OTP_DEBUG=0
