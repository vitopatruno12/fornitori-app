; Template per /opt/fornitori-app/backend/.env in produzione.
; Copialo (rinomina in .env) e EDITA i valori reali.
;
; IMPORTANTE: NON committare mai il file .env reale nel repo.
; Permessi: chmod 600 /opt/fornitori-app/backend/.env (solo proprietario lo legge).

# --- Database ---
# Prendi questo valore da /root/fornitori_db_credentials.txt (creato da install-server.sh)
# Esempio (sostituisci PASSWORD generato):
DATABASE_URL=postgresql://fornitori_user:PASSWORD_AUTOGENERATED_HERE@localhost:5432/fornitori_db

# --- CORS ---
# In produzione vuoi limitare gli origin che possono chiamare l'API.
# Dato che il frontend gira su Vercel, metti la URL pubblica del frontend:
CORS_ORIGINS=https://fornitori-app-uvke.vercel.app,https://fornitori-app.vercel.app
# Per coprire i preview deploy Vercel con URL dinamico (consigliato):
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*vercel\.app

# --- Comportamento app ---
LOG_LEVEL=INFO
DEBUG_ERRORS=false
ALLOW_STARTUP_DB_FAILURE=true

# --- Integrazioni opzionali (lascia vuote se non usate) ---

# Aruba API fatture elettroniche:
#ARUBA_API_USERNAME=
#ARUBA_API_PASSWORD=
#ARUBA_API_OWNER_USERNAME=
#ARUBA_API_ENV=production
#ARUBA_PORTAL_SID=
#ARUBA_RECEIVER_VATCODE=
#ARUBA_RECEIVER_FISCALCODE=
#ARUBA_RECEIVER_CODE=

# VNE (area cassa):
#VNE_USERNAME=
#VNE_PASSWORD=

# SDI (sicurezza endpoint ricezione fatture):
#SDI_RECEIVE_TOKEN=
