# Esempio Nginx per www.atlass.it (Ubuntu).
# PROBLEMA COMUNE: redirect 307 da /api/suppliers → http://.../suppliers/
# causa Mixed Content. Tutte le API devono andare al backend, non alla SPA.
#
# Installazione:
#   sudo cp deploy/nginx-atlass.example /etc/nginx/sites-available/atlass
#   sudo ln -sf /etc/nginx/sites-available/atlass /etc/nginx/sites-enabled/atlass
#   sudo nginx -t && sudo systemctl reload nginx

# Redirect HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name www.atlass.it atlass.it;
    return 301 https://www.atlass.it$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.atlass.it atlass.it;

    # Certificati Let's Encrypt (certbot)
    ssl_certificate     /etc/letsencrypt/live/www.atlass.it/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.atlass.it/privkey.pem;

    root /opt/fornitori-app/frontend/dist;
    index index.html;

    # IMPORTANTE: ^~ = priorità su location regex / SPA
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 25M;
        # VNE overview può richiedere fino ~90s: evita 504 Gateway Timeout.
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }

    # Frontend React (solo file statici, NO redirect delle API)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
