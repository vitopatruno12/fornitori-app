# Copia in .env.development (gitignored) per npm run dev in locale:
#   copy .env.development.example .env.development   (Windows)
#   cp .env.development.example .env.development      (Mac/Linux)
#
# Caricato solo in development. Nessun http:// nel browser: proxy Vite (vite.config.ts).

# Usa /api (proxy Vite → http://127.0.0.1:8000). Non usare https://127.0.0.1:8000 in locale.
VITE_API_BASE_URL=/api
