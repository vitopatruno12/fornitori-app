# Sviluppo locale: copia in frontend/.env.development (gitignored)
#   VITE_API_BASE_URL=/api
#   (proxy Vite → FastAPI 8000; AI via Ollama su /api/ai)
#
# Produzione (vite build): frontend/.env.production nel repo
#   VITE_API_BASE_URL=/api
#   VITE_PUBLIC_APP_URL=https://www.atlass.it
#   Su Vercel/Netlify: NON impostare http://www.atlass.it (senza /api causa Mixed Content)
#
# Link satelliti operatore (/operatore-ordine, /operatore-consegne, /operatore-prima-nota)
# usano sempre HTTPS tramite VITE_PUBLIC_APP_URL in build di produzione.
