# Sviluppo locale: copia in frontend/.env.development (gitignored)
#   VITE_API_BASE_URL=http://localhost:8000
#   VITE_AI_API_URL=http://localhost:3001
#
# Produzione (vite build): frontend/.env.production nel repo
#   VITE_API_BASE_URL=/api
#
# api.js usa import.meta.env.VITE_API_BASE_URL con fallback /api (nessun localhost nel codice).
