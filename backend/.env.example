# Esempio di backend/.env per sviluppo LOCALE.
# Copialo in backend/.env e modifica i valori.
# backend/.env e' in .gitignore: i tuoi valori NON finiranno in git.

# --- Database locale ---
# Adatta utente/password/host alla tua installazione di Postgres
DATABASE_URL=postgresql://fornitori_user:fornitori_pass@localhost:5432/fornitori_db

# --- CORS ---
# In dev "*" e' comodo. In produzione metti gli origin del frontend.
CORS_ORIGINS=*

# --- Comportamento app ---
LOG_LEVEL=INFO
# In dev tieni true: il body delle risposte 500/503 include il messaggio
# dell'eccezione, utile per capire al volo cosa non va.
DEBUG_ERRORS=true

# --- AI: Ollama locale (default, gratuito) ---
# Installa Ollama: https://ollama.com â€” poi: ollama pull qwen2.5:7b
# Modelli piÃ¹ precisi (piÃ¹ RAM): qwen2.5:14b, llama3.1:8b
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_CHAT_URL=http://localhost:11434/api/chat  # opzionale, derivato da OLLAMA_URL
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_USE_CHAT=1
OLLAMA_JSON_FORMAT=1
OLLAMA_TEMPERATURE=0.05
OLLAMA_TIMEOUT_SEC=120
OLLAMA_STAFF_TIMEOUT_SEC=90
OLLAMA_ORDER_TIMEOUT_SEC=45
OLLAMA_ORDER_NUM_PREDICT=512
OLLAMA_SUPPLIER_NUM_PREDICT=384
OLLAMA_NUM_PREDICT=384

# --- Opzionale: Google Gemini (AI_PROVIDER=gemini + chiave) ---
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash

# --- Link codici: sblocco con password (OTP WhatsApp temporaneamente disattivato) ---
#ACCESS_CODES_UNLOCK_PASSWORD=Burnet
#
# --- Link codici: OTP su WhatsApp Business (Meta), senza Twilio ---
#ACCESS_CODES_OTP_PHONE=3331234567
#ACCESS_CODES_OTP_TTL_SEC=300
#
# Webhook locale sul server:
#ACCESS_CODES_OTP_WEBHOOK_URL=http://127.0.0.1:8791/send
#
# Credenziali Meta (developers.facebook.com â†’ App â†’ WhatsApp â†’ API Setup):
#WHATSAPP_CLOUD_TOKEN=
#WHATSAPP_PHONE_NUMBER_ID=
#WHATSAPP_GRAPH_VERSION=v21.0
# Template autenticazione (consigliato in produzione, dopo approvazione Meta):
#WHATSAPP_OTP_TEMPLATE=atlas_otp
#WHATSAPP_OTP_TEMPLATE_LANG=it
#WHATSAPP_OTP_TEMPLATE_BUTTON=copy_code
# Stesso token: avviso ritiro automatico al trasportatore (testo libero)
#
# Solo sviluppo: OTP in risposta API
#ACCESS_CODES_OTP_DEBUG=1

# --- Banca: login home banking + OTP (credenziali SOLO in .env) ---
#BANK_NAME=BCC Terra d'Otranto
#BANK_IBAN=IT06B0844516000000972450
#BANK_USERNAME=
#BANK_PASSWORD=
#BANK_PORTAL_URL=
# Telefono che riceve OTP di collegamento (default: ACCESS_CODES_OTP_PHONE)
#BANK_OTP_PHONE=
#BANK_OTP_TTL_SEC=300
#BANK_OTP_WEBHOOK_URL=
# In sviluppo: OTP in risposta API e log (senza SMS)
#BANK_OTP_DEBUG=1

# --- Enable Banking (AIS / Open Banking) ---
#ENABLE_BANKING_APP_ID=
#ENABLE_BANKING_KEY_PATH=./keys/your-app-id.pem
#ENABLE_BANKING_REDIRECT_URL=https://www.atlass.it/api/banca/callback
#ENABLE_BANKING_ENVIRONMENT=sandbox
#ENABLE_BANKING_ASPSP_NAME=Nordea
#ENABLE_BANKING_ASPSP_COUNTRY=FI
#ENABLE_BANKING_FRONTEND_URL=https://www.atlass.it
#ENABLE_BANKING_CONSENT_DAYS=90

# --- Credenziali esterne (vuote in dev se non testi quelle integrazioni) ---
# Canale SDI / Agenzia Entrate (senza Aruba):
#SDI_RECEIVE_TOKEN=
#SDI_DEST_ABBA_KEYWORDS=abba,via abba,cesare abba
#SDI_DEST_ZANARDELLI_KEYWORDS=zanardelli,via zanardelli
#
# --- AdE agent (PC agenzia + chiavetta CNS) → POST /sdi/receive ---
# Script: backend/scripts/ade_sync_agent.py
#   pip install -r requirements-ade-agent.txt && playwright install chrome
#ADE_PROFILES_PATH=C:/AtlasSync/ade/profiles.json
#ADE_HEADLESS=0
#ADE_USE_SYSTEM_CHROME=1
#ADE_CNS_PIN_WAIT_SEC=180
#ADE_LOGIN_TIMEOUT_SEC=300
#ADE_LOOKBACK_DAYS=60
#ADE_PORTAL_URL=https://ivaservizi.agenziaentrate.gov.it/portale/
#ADE_FATTURE_RICEVUTE_URL=
#ADE_XML_DROP_DIR=C:/AtlasSync/ade
#ADE_DEBUG_DIR=
#ADE_STATE_PATH=
# Oppure profili via env: ADE_PROFILE_1_ID=via_abba ADE_PROFILE_1_SEDE=via_abba ADE_PROFILE_1_AUTH=cns
#
# --- Passcom Live agent (PC Windows, Playwright) → POST /sdi/receive ---
# Script: backend/scripts/passcom_sync_agent.py
#   pip install -r requirements-passcom-agent.txt && playwright install chromium
#PASSCOM_DOMAIN=
#PASSCOM_USERNAME=
#PASSCOM_PASSWORD=
#PASSCOM_BASE_URL=https://webdesk.passgo.cloud/webdesk/wd
#PASSCOM_LOOKBACK_DAYS=30
#PASSCOM_HEADLESS=1
#PASSCOM_LOGIN_TIMEOUT_SEC=420
#PASSCOM_UI_READY_TIMEOUT_SEC=360
#PASSCOM_DEBUG_DIR=
#PASSCOM_XML_DROP_DIR=
#PASSCOM_STATE_PATH=
# Coordinate click opzionali (calibrazione UI canvas):
# PASSCOM_CLICK_AZIENDA_ROW_X/Y, PASSCOM_CLICK_APRI_ULTIMO_ANNO_X/Y, PASSCOM_CLICK_APERTURA_OK_X/Y
# PASSCOM_CLICK_DOCUVISION_X/Y, PASSCOM_CLICK_FATTURE_ELETTRONICHE_X/Y, PASSCOM_CLICK_FATTURE_RICEVUTE_X/Y
# PASSCOM_CLICK_EXPORT_X/Y, PASSCOM_CLICK_LIST_X/Y, PASSCOM_CLICK_LOGOUT_X/Y
#ATLAS_API_BASE=https://www.atlass.it/api
#VNE_USERNAME=
#VNE_PASSWORD=
# VNE Remote dal server Atlas: usare HTTP (HTTPS dÃ  SSL UNSUPPORTED_PROTOCOL).
# Imposta MACHINE_URL (pagina portale VIRTUO) oppure STATUS_URL supervlt diretto.
# La Risacca (VIRTUO20221721) â€” path supervlt cambia: il backend lo riscopre dall'iframe
#VNE_MODEL_1_MACHINE_URL=http://www.vneremote.com/vne/VIRTUO20221721/
#VNE_MODEL_1_STATUS_URL=http://vneremote.com/32/250/supervlt/stato
#VNE_MODEL_1_REFERER_URL=http://vneremote.com/32/250/supervlt/?param=NO
# Mani in Pasta (VIRTUO20221720)
#VNE_MODEL_2_MACHINE_URL=http://www.vneremote.com/vne/VIRTUO20221720/
#VNE_MODEL_2_STATUS_URL=http://vneremote.com/33/231/supervlt/stato
#VNE_MODEL_2_REFERER_URL=http://vneremote.com/33/231/supervlt/?param=NO
# Le Mucche Volanti (VIRTUO20221707)
#VNE_MODEL_3_MACHINE_URL=http://www.vneremote.com/vne/VIRTUO20221707/
#VNE_MODEL_3_STATUS_URL=http://vneremote.com/29/10/supervlt/stato
#VNE_MODEL_3_REFERER_URL=http://vneremote.com/29/10/supervlt/?param=NO
#VNE_MODEL_1_SALA=Bar Momento
#VNE_MODEL_1_CITY=Viareggio
#VNE_MODEL_1_REGION=Toscana
#VNE_LIST_URL=http://www.vneremote.com/vne/lista/
#VNE_STATUS_MAX_TOTAL_SEC=40
#VNE_HEALTH_MAX_TOTAL_SEC=75
#VNE_HEALTH_PER_MODEL_SEC=18
#VNE_HTTP_TIMEOUT_SEC=20

# --- EasyRetail GDB -> scontrini ATLAS (Orari di punta quasi real-time) ---
# Token condiviso tra agent PC cassa e server (header X-Atlas-Sync-Token)
#EASYRETAIL_SYNC_TOKEN=cambia-questo-token
# Solo sviluppo: permette ingest senza token
#EASYRETAIL_SYNC_ALLOW_OPEN=0
#
# Modalità consigliata: agent sul PC cassa (script backend/scripts/easyretail_gdb_sync_agent.py)
#ATLAS_API_BASE=https://www.atlass.it/api
#EASYRETAIL_GDB_PATH=C:\\EasyRetail\\DBase\\DBRETAIL.GDB
#EASYRETAIL_FBCLIENT=C:\\EasyRetail\\DBase\\fbclient.dll
#EASYRETAIL_MODEL_ID=model-2
#EASYRETAIL_GDB_USER=SYSDBA
#EASYRETAIL_GDB_PASSWORD=masterkey
#EASYRETAIL_GDB_LOOKBACK_HOURS=48
#
# Solo se il SERVER ATLAS vede il GDB in rete/locale:
#EASYRETAIL_GDB_SYNC_ENABLED=0
#EASYRETAIL_GDB_SYNC_INTERVAL_SEC=180
#EASYRETAIL_GDB_DSN=C:\\EasyRetail\\DBase\\DBRETAIL.GDB
